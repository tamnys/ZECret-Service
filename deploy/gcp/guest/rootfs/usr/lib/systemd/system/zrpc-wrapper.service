[Unit]
Description=Attested TLS testnet RPC
Requires=zrpc-gcp-quote.service zrpc-node.service zrpc-cookie.service
BindsTo=zrpc-gcp-quote.service zrpc-node.service
After=zrpc-gcp-quote.service zrpc-node.service zrpc-cookie.service
OnFailure=poweroff.target
OnFailureJobMode=replace-irreversibly
SuccessAction=poweroff
RefuseManualStart=yes

[Service]
Type=simple
User=zrpc-wrapper
Group=zrpc-wrapper
SupplementaryGroups=zrpc-cookie
ExecStartPre=+/usr/lib/zrpc/zrpc-gcp-guard --mark-start wrapper
ExecStartPre=/usr/lib/zrpc/zrpc-gcp-guard --check wrapper
# ExecStart is generated from independently measured resource inputs by prepare.py.
Restart=no
KillMode=control-group
OOMPolicy=kill
UMask=0077
LimitCORE=0
StandardOutput=null
StandardError=null
NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
PrivateDevices=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_INET AF_UNIX
InaccessiblePaths=/var/lib/zebra /sys/kernel/config /sys/firmware
