[Unit]
Description=Handoff cookie before starting private RPC wrapper
Requires=zrpc-node.service
BindsTo=zrpc-node.service
After=zrpc-node.service
OnFailure=poweroff.target
OnFailureJobMode=replace-irreversibly
Wants=zrpc-wrapper.service
Before=zrpc-wrapper.service
RefuseManualStart=yes

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStartPre=+/usr/lib/zrpc/zrpc-gcp-guard --mark-start cookie
ExecStartPre=/usr/lib/zrpc/zrpc-gcp-guard --check cookie
# ExecStart and TimeoutStartSec are generated from measured startup timing inputs.
Restart=no
LimitCORE=0
UMask=0077
StandardOutput=null
StandardError=null
ProtectSystem=strict
NoExecPaths=/run /tmp /var /dev
ReadWritePaths=/run/zrpc-wrapper
InaccessiblePaths=/run/zrpc-gcp-quote /var/lib/zebra /sys/kernel/config /sys/firmware
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_CHOWN CAP_DAC_READ_SEARCH
RestrictAddressFamilies=AF_UNIX
