{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "zecret-service",
  "main": "./worker.ts",
  "compatibility_date": "2026-09-28",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "observability": {
    "enabled": false
  }
}
